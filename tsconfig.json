{
  // Type checking and MicroTS module resolution. PocketJS and Solid come from
  // the vendored checkout, not from npm.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "solid-js": ["./vendor/pocketjs/node_modules/solid-js"],
      "solid-js/*": ["./vendor/pocketjs/node_modules/solid-js/*"],
      "@pocketjs/framework/solid": ["./vendor/pocketjs/framework/src/index.ts"],
      "@pocketjs/framework/solid/std": [
        "./vendor/pocketjs/framework/src/std-microts.ts"
      ],
      "@pocketjs/framework/solid/components": [
        "./vendor/pocketjs/framework/src/components.ts"
      ],
      "@pocketjs/framework/solid/lifecycle": [
        "./vendor/pocketjs/framework/src/lifecycle.ts"
      ],
      "@pocketjs/framework/input": [
        "./vendor/pocketjs/framework/src/input-api.ts"
      ],
      "@pocketjs/framework/animation": [
        "./vendor/pocketjs/framework/src/animation.ts"
      ]
    }
  },
  "include": ["app", "art", "scripts", "host/*.ts"]
}
